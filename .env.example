# Copy this file to .env and fill in your API key to enable LLM generation.
# If no key is provided, the app uses a built-in template-based generator
# (which still works, but without natural-language rewriting).

# OpenAI-compatible API key (e.g. OpenAI, DeepSeek, or any OpenAI-compatible endpoint)
OPENAI_API_KEY=your_api_key_here

# Optional: custom API base URL for OpenAI-compatible providers
# OPENAI_API_BASE=https://api.openai.com/v1

# Optional: model name
# LLM_MODEL=gpt-4o-mini

# Optional: server port
# PORT=8000
