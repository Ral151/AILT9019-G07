# Copy to .env (never commit .env). Everything is server-side only.
#
# Without an LLM API key the app still runs: refusals, deferrals and hazardous
# answers work (they are templates), but normal answers return
# SERVICE_UNAVAILABLE until a key is set.

# --- Text LLM provider
# openrouter | qwen | none | mock (tests/plumbing only, never for real answers).
# If unset: the first provider below whose API key is set (OpenRouter first).
# TEXT_PROVIDER=openrouter
#
# Model IDs. Leave unset to use the provider's default:
#   openrouter -> nvidia/nemotron-3.5-super-vl:free
#   qwen       -> qwen-plus
# Intent and answers may use different models (INTENT_MODEL defaults to TEXT_MODEL).
# TEXT_MODEL=
# INTENT_MODEL=

# --- OpenRouter (default). Key from https://openrouter.ai/settings/keys
# Free (":free") models: 20 requests/min, 50 requests/day (1,000/day once the
# account has bought >= $10 credit). Each text question uses 2 LLM calls.
# Check "Training on prompts" in the OpenRouter privacy settings.
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Qwen on Alibaba Cloud Model Studio (International / Singapore), optional
QWEN_API_KEY=
# Copy the exact base URL from the Model Studio console (OpenAI-compatible mode).
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# --- Vision (milestone M4; not used yet)
VISION_MODEL_PRIMARY=qwen3-vl-plus
VISION_MODEL_FALLBACK=qwen3-vl-flash
# GROQ_API_KEY=
# GROQ_VISION_MODEL=qwen/qwen3.8-27b

# --- Retrieval
# Calibrated on the dev split (eval/reports/tau_calibration.md). Re-run
# `python -m eval.calibrate_tau --split dev` after changing the corpus or model.
RETRIEVE_TAU=0.688
CHROMA_PATH=data/chroma
EMBED_MODEL=BAAI/bge-small-en-v1.5

# --- Request handling
PROVIDER_TIMEOUT_S=15
RATE_LIMIT=20
# Comma-separated origins allowed to call the API from another origin. Not
# needed locally: the Vite dev server proxies /api.
CORS_ORIGINS=
# on | auto (only when the provider fails) | off
DEMO_CACHE=auto
